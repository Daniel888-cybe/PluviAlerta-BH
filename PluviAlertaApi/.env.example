# Copie para .env e preencha. O .env NUNCA vai para o repositório (já está no .gitignore).

# Banco MySQL usado pelo docker compose
MYSQL_DATABASE=pluvialerta
MYSQL_USER=pluvialerta
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT das rotas de administração (simulação). Chave com 32+ caracteres aleatórios.
# Gere com: openssl rand -base64 48
JWT_CHAVE=
# Login do admin em POST /api/auth/token
ADMIN_USUARIO=admin
ADMIN_SENHA=

# Token do bot do Telegram (gerado pelo @BotFather). Pode ficar vazio até o passo do bot.
TELEGRAM_BOT_TOKEN=
